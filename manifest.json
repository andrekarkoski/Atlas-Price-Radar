{
  "manifest_version": 3,
  "name": "Atlas Price Radar",
  "version": "0.1.0",
  "description": "Monitor de preços e ofertas para produtos desejados.",
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.magazineluiza.com.br/*"
      ],
      "js": [
        "dist/content/content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "dist/background/background.js",
    "type": "module"
  }
}